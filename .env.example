# Copy to .env.local and fill in. .env.local is gitignored.
# Nothing here is required — these are overrides with sane defaults.

# Where digests are written. Defaults to ~/Documents/ObsidianVault/Digests
VAULT_DIGEST_DIR=

# User-Agent for the feed fetchers. Reddit rejects generic agents.
FEEDS_USER_AGENT=phone-mirroring-pulling-news/0.1 (personal use)

# Keep captured frames after a run for debugging. Default: deleted once read.
KEEP_FRAMES=0
